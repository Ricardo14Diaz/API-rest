    {
      "name": "4. Favoritos y aislamiento",
      "item": [
        {
          "name": "4.1 Agregar favorito",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/favoritos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "favoritos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{ \"productoId\": {{producto_id}} }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_a}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "4.2 Consultar favoritos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Contiene el producto favorito\", () => { const ids = pm.response.json().favoritos.map(f => f.id); pm.expect(ids).to.include(Number(pm.collectionVariables.get('producto_id'))); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/favoritos",
              "host": [
