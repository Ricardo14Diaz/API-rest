                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Sin favoritos huérfanos\", () => pm.expect(pm.response.json().favoritos).to.have.lengthOf(0));"
                ]
