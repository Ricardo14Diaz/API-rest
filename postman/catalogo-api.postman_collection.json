{
  "info": {
    "name": "Catálogo API - Pruebas",
    "description": "Ejecutar en orden con el entorno \"Catálogo API - Local\". La carpeta 6 se ejecuta después de reiniciar Node.js.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "1.1 Registrar usuario",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('run_id')) pm.collectionVariables.set('run_id', Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"Rol es usuario y hay id\", () => { pm.expect(j.usuario.rol).to.eql('usuario'); pm.expect(j.usuario.id).to.be.a('number'); });",
                  "pm.test(\"No expone contraseña ni hash\", () => { const t = pm.response.text(); pm.expect(t).to.not.include(\"password\"); pm.expect(t).to.not.include(\"hash\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/registro",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario A\",\n  \"correo\": \"a_{{run_id}}@ejemplo.com\",\n  \"password\": \"ClaveSegura1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "1.2 Iniciar sesion como usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Devuelve token Bearer\", () => { pm.expect(j.token).to.be.a('string'); pm.expect(j.token_type).to.eql('Bearer'); });",
                  "pm.collectionVariables.set('token_a', j.token);",
                  "pm.test(\"No expone contraseña ni hash\", () => { const t = pm.response.text(); pm.expect(t).to.not.include(\"password\"); pm.expect(t).to.not.include(\"hash\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"a_{{run_id}}@ejemplo.com\",\n  \"password\": \"ClaveSegura1\",\n  \"rol\": \"usuario\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "1.3 Iniciar sesion como admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token_admin', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\",\n  \"rol\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "2. Productos",
      "item": [
        {
          "name": "2.1 Listar productos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Hay al menos 5 productos\", () => pm.expect(pm.response.json().productos.length).to.be.at.least(5));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/productos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "2.2 Crear producto como admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 201\", () => pm.response.to.have.status(201));",
                  "const p = pm.response.json().producto;",
                  "pm.test(\"Producto creado con precio numérico\", () => { pm.expect(p.id).to.be.a('number'); pm.expect(p.precio).to.eql(45.5); });",
                  "pm.collectionVariables.set('producto_id', p.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/productos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Webcam Lumen HD\",\n  \"descripcion\": \"Cámara 1080p con micrófono\",\n  \"categoria\": \"Accesorios\",\n  \"precio\": 45.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_admin}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "2.3 Consultar producto creado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Es el producto creado\", () => pm.expect(pm.response.json().producto.nombre).to.eql('Webcam Lumen HD'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/productos/{{producto_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "productos",
                "{{producto_id}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "2.4 Actualizar producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Precio actualizado y nombre intacto\", () => { const p = pm.response.json().producto; pm.expect(p.precio).to.eql(39.99); pm.expect(p.nombre).to.eql('Webcam Lumen HD'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/productos/{{producto_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "productos",
                "{{producto_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 39.99\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_admin}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
